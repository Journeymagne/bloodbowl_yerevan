      "name": "Primary button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The solid copper action shared by season, team and form flows.",
      "html": "<button class=\"ds-primary\" type=\"button\">Open season</button>",
      "css": ".ds-primary{display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:0 14px;border:1px solid var(--primary-border,#99502c);border-radius:var(--radius,4px);background:var(--primary-bg,#99502c);color:var(--primary-text,#ffffff);font-weight:700;text-decoration:none;cursor:pointer;font-family:var(--font-body,\"Golos Text\",ui-sans-serif,system-ui,sans-serif);font-size:16px;}.ds-primary:hover{border-color:var(--line-bright,#9eafb9);background:var(--primary-bg-hover,#7e3f22);}.ds-primary:disabled{opacity:.6;cursor:not-allowed;}.ds-primary:focus-visible{outline:2px solid var(--focus,#f3b27e);outline-offset:2px;border-radius:var(--radius,4px);}"
    },
    {
      "name": "Ghost button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Quiet secondary actions using the current theme surface.",
      "html": "<button class=\"ds-ghost\" type=\"button\">Close</button>",
      "css": ".ds-ghost{display:inline-flex;align-items:center;min-height:44px;padding:0 10px;border:1px solid var(--button-border,#3f5664);border-radius:var(--radius,4px);background:var(--button-bg,#182b3a);color:var(--button-text,#f0f4f5);text-decoration:none;cursor:pointer;font-family:var(--font-body,\"Golos Text\",ui-sans-serif,system-ui,sans-serif);font-size:16px;justify-content:center;}.ds-ghost:hover{border-color:var(--line-bright,#9eafb9);background:var(--button-bg-hover,#213847);color:var(--button-text,#f0f4f5);}.ds-ghost:focus-visible{outline:2px solid var(--focus,#f3b27e);outline-offset:2px;border-radius:var(--radius,4px);}.ds-ghost:disabled{opacity:.6;cursor:not-allowed;}"
    },
    {
      "name": "Labeled field",
      "kind": "input",
      "refersTo": "input",
      "description": "Stacked labels and solid inputs used in account and filtering forms.",
      "html": "<label class=\"ds-field\"><span class=\"ds-field-label\">Login</span><input class=\"ds-field-input\" autocomplete=\"username\" placeholder=\"Login\"></label>",
      "css": ".ds-field{display:grid;gap:6px;font-family:var(--font-body,\"Golos Text\",ui-sans-serif,system-ui,sans-serif);font-size:16px;}.ds-field-label{color:var(--muted,#b7c7d0);font-size:12px;}.ds-field-input{width:100%;min-height:44px;padding:0 10px;border:1px solid var(--line,#3f5664);border-radius:var(--radius,4px);background:var(--input-bg,#182b3a);color:var(--text,#f0f4f5);font-family:var(--font-body,\"Golos Text\",ui-sans-serif,system-ui,sans-serif);font-size:16px;}.ds-field-input::placeholder{color:var(--muted,#b7c7d0);opacity:1;}.ds-field-input:focus{border-color:var(--focus,#f3b27e);}.ds-field-input:focus-visible{outline:2px solid var(--focus,#f3b27e);outline-offset:2px;border-radius:var(--radius,4px);}"
    },
    {
      "name": "Masthead navigation",
      "kind": "nav",
      "description": "Dark masthead links with a copper rule for the active destination.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Example navigation\"><a class=\"ds-nav-link ds-nav-active\" href=\"#/\" aria-current=\"page\">Clubhouse</a><a class=\"ds-nav-link\" href=\"#/season\">Season</a><a class=\"ds-nav-link\" href=\"#/pages\">References</a></nav>",
      "css": ".ds-nav{display:flex;flex-wrap:wrap;gap:2px;background:var(--masthead,#172d40);}.ds-nav-link{display:flex;align-items:center;min-height:48px;padding:12px;border-bottom:2px solid transparent;color:var(--masthead-muted,#c0cdd5);text-decoration:none;font-family:var(--font-body,\"Golos Text\",ui-sans-serif,system-ui,sans-serif);font-size:14px;font-weight:500;}.ds-nav-link:hover,.ds-nav-active{background:#253f53;color:var(--masthead-text,#f3f5f4);}.ds-nav-active{border-bottom-color:#d49971;}.ds-nav-link:focus-visible{outline:2px solid var(--focus,#f3b27e);outline-offset:2px;border-radius:var(--radius,4px);}"
    },
    {
      "name": "Reference chip",
      "kind": "chip",
      "refersTo": "chip",
      "description": "Compact linked labels using the existing chip dimensions and hover treatment.",
      "html": "<a class=\"ds-chip\" href=\"#/pages\">References</a>",
      "css": ".ds-chip{display:inline-flex;align-items:center;min-height:44px;padding:0 10px;border:1px solid var(--button-border,#3f5664);border-radius:var(--radius,4px);background:var(--button-bg,#182b3a);color:var(--button-text,#f0f4f5);text-decoration:none;cursor:pointer;font-family:var(--font-body,\"Golos Text\",ui-sans-serif,system-ui,sans-serif);font-size:16px;min-height:34px;color:var(--button-muted-text,#f0f4f5);}.ds-chip:hover{border-color:var(--line-bright,#9eafb9);background:var(--button-bg-hover,#213847);color:var(--button-text,#f0f4f5);}.ds-chip:focus-visible{outline:2px solid var(--focus,#f3b27e);outline-offset:2px;border-radius:var(--radius,4px);}"
    },
    {
      "name": "Reference card",
      "kind": "card",
      "refersTo": "card",
      "description": "A linked catalogue card with a restrained border response.",
      "html": "<a class=\"ds-card\" href=\"#/pages\"><h2 class=\"ds-card-title\">References</h2><p class=\"ds-card-copy\">Teams, skills and rules.</p></a>",
      "css": ".ds-card{position:relative;display:block;min-height:122px;padding:16px;border:1px solid var(--line,#3f5664);border-radius:var(--radius,4px);overflow:hidden;background:var(--panel-glass,#182b3a);color:var(--text,#f0f4f5);text-decoration:none;font-family:var(--font-body,\"Golos Text\",ui-sans-serif,system-ui,sans-serif);font-size:16px;}.ds-card:hover{border-color:var(--line-bright,#9eafb9);background:var(--surface-strong,#182b3a);}.ds-card-title{margin:0;font-family:var(--font-display,\"Oswald\",sans-serif);font-size:20px;font-weight:500;line-height:1.2;}.ds-card-copy{margin:10px 0 0;color:var(--muted,#b7c7d0);line-height:1.45;}.ds-card:focus-visible{outline:2px solid var(--focus,#f3b27e);outline-offset:2px;border-radius:var(--radius,4px);}"
    },
    {
      "name": "Journal rule link",
      "kind": "custom",
      "description": "Ruled rows make frequently consulted rules easy to scan without separate cards.",
      "html": "<a class=\"ds-row\" href=\"#/pages\"><span class=\"ds-row-label\">Weather</span><svg class=\"ds-row-arrow\" aria-hidden=\"true\" viewBox=\"0 0 24 24\"><path d=\"M4 12h15m-6-6 6 6-6 6\"></path></svg></a>",
      "css": ".ds-row{display:flex;align-items:center;justify-content:space-between;gap:18px;min-height:54px;padding:16px 0;border-bottom:1px solid var(--line,#3f5664);color:var(--text,#f0f4f5);font-family:var(--font-body,\"Golos Text\",ui-sans-serif,system-ui,sans-serif);font-size:14px;line-height:1.55;text-decoration:none;}.ds-row-label{min-width:0;font-weight:600;}.ds-row:hover{color:var(--soft,#e8af87);}.ds-row-arrow{width:20px;height:20px;flex:0 0 20px;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round;}.ds-row:focus-visible{outline:2px solid var(--focus,#f3b27e);outline-offset:2px;border-radius:var(--radius,4px);}"
    },
    {
      "name": "Compact standings",
      "kind": "custom",
      "description": "Three fixed-layout columns that shrink on phones; sample row is explicitly synthetic.",
      "html": "<table class=\"ds-standings\" aria-label=\"Synthetic standings example\"><thead><tr><th class=\"ds-standing-cell ds-standing-head\" scope=\"col\">#</th><th class=\"ds-standing-cell ds-standing-head\" scope=\"col\">Team</th><th class=\"ds-standing-cell ds-standing-head\" scope=\"col\">League points</th></tr></thead><tbody><tr><td class=\"ds-standing-cell\">1</td><td class=\"ds-standing-cell\">Example team</td><td class=\"ds-standing-cell ds-standing-points\">0</td></tr></tbody></table>",
      "css": ".ds-standings{width:100%;min-width:0;border-collapse:collapse;table-layout:fixed;color:var(--text,#f0f4f5);font-family:var(--font-body,\"Golos Text\",ui-sans-serif,system-ui,sans-serif);line-height:1.55;}.ds-standing-cell{padding:12px 8px;border:1px solid var(--line,#3f5664);font-size:14px;overflow-wrap:anywhere;vertical-align:top;background:var(--surface-soft,#213847);}.ds-standing-head{font-size:12px;font-weight:500;text-align:left;color:var(--muted,#b7c7d0);background:var(--table-head,#213847);}.ds-standing-head:first-child{width:40px;}.ds-standing-head:last-child{width:90px;}.ds-standing-points{font-weight:600;font-variant-numeric:tabular-nums;}"
    },
    {
      "name": "Close control",
      "kind": "button",
      "description": "A localized accessible close icon. 44px hit area, 20px strokes; beside the identity in the drawer and title in authentication.",
      "html": "<div class=\"ds-close-frame\"><button class=\"ds-close\" type=\"button\" aria-label=\"Close\"><svg aria-hidden=\"true\" viewBox=\"0 0 24 24\"><path d=\"m6 6 12 12M18 6 6 18\"></path></svg></button></div>",
      "css": ".ds-close-frame{display:inline-block;padding:8px;background:#172d40}.ds-close{display:grid;place-items:center;width:44px;height:44px;padding:0;border:0;border-radius:4px;background:transparent;color:#f0f4f5;cursor:pointer}.ds-close svg{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round}.ds-close:hover{background:#253f53}.ds-close:focus-visible{outline:2px solid #f3b27e;outline-offset:2px}"
    },
    {
      "name": "Account mode switch",
      "kind": "button",
      "description": "A secondary mode switch under the primary submit. Underlined 44px action and a muted contextual hint.",
      "html": "<div class=\"ds-auth-switch-row\"><span>No account yet?</span><button type=\"button\" class=\"ds-auth-switch\">Create account</button></div>",
      "css": ".ds-auth-switch-row{display:flex;flex-wrap:wrap;align-items:center;justify-content:center;column-gap:8px;padding:8px 16px;border-top:1px solid #3f5664;background:#182b3a;color:#b7c7d0;font:14px/1.55 \"Golos Text\",ui-sans-serif,system-ui,sans-serif}.ds-auth-switch{min-height:44px;padding:8px 0;border:0;border-radius:2px;background:transparent;color:#e8af87;font:600 14px/1.55 \"Golos Text\",ui-sans-serif,system-ui,sans-serif;text-decoration:underline;text-underline-offset:4px;cursor:pointer}.ds-auth-switch:hover{color:#f0f4f5}.ds-auth-switch:focus-visible{outline:2px solid #f3b27e;outline-offset:2px}"
    }
  ],
  "narrative": {
    "northStar": "Club tournament journal",
    "overview": "A practical competition programme for the Gata club: condensed sports headings, calm reading text, ruled information and restrained copper actions. Solid navy anchors the identity; cool light surfaces and the existing dark themes give players a comfortable workspace. The supplied Gata emblem remains the visual identifier.\n\nPremium character comes from hierarchy, measured spacing and careful tables. Existing players should recognize a working league desk, with season, matches, teams and rules easy to scan in English or Russian. The selected world is recorded in the index body contract (candidate 5, seed 22546323); screenshot demo scores and names are test fixtures, never brand or season facts.",
    "keyCharacteristics": [
      "Condensed Oswald headings paired with Golos Text reading text.",
      "Solid surfaces, thin rules and small corners.",
      "Copper primary actions within a navy club frame.",
      "Dense information that reflows deliberately on phones.",
      "Equal visual care for English, Russian and all six themes."
    ],
    "rules": [
      {
        "name": "The Semantic Surface Rule",
        "body": "Build with the existing CSS aliases so a new surface follows every theme automatically.",
        "section": "colors"
      },
      {
        "name": "The Two Scripts Rule",
        "body": "Preserve hierarchy and available width when copy switches between English and Russian; do not shrink Russian into a separate visual system.",
        "section": "typography"
      },
      {
        "name": "The Solid Ground Rule",
        "body": "Keep permanent surfaces opaque and border-led; reserve shadow for temporary surfaces above the page.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** use semantic CSS aliases and check all six theme IDs.",
      "**Do** retain the supplied emblem, Oswald headings and Golos Text reading text.",
      "**Do** check English and Russian at desktop and phone widths.",
      "**Do** preserve visible keyboard focus, drawer containment and reduced-motion behavior.",
      "**Do** keep compact home standings shrinkable and long team names readable.",
      "**Do** use real loading, empty and unavailable states when live data is absent."
    ],
    "donts": [
      "**Don't** reintroduce decorative glass, glows or patterned backgrounds through legacy aliases.",
      "**Don't** replace ruled reference lists with a uniform grid of floating cards.",
      "**Don't** use primary-action colors as a substitute for semantic status colors.",
      "**Don't** remove existing theme choices or treat Russian labels as secondary.",
      "**Don't** promote synthetic screenshot names, dates or scores into product claims."
    ]
  }
}
