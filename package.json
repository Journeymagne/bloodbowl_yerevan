{
  "name": "bloodbowl-sevens-reference",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "import:gata": "python scripts/import-gata-content.py",
    "build": "node scripts/build-data.mjs && node scripts/build-site.mjs",
    "i18n:check": "node scripts/check-i18n-glossary.mjs && node scripts/check-i18n-strings.mjs",
    "dev": "node scripts/build-data.mjs && node scripts/serve.mjs",
    "server": "node server/server.mjs",
    "start": "npm run build && node server/server.mjs",
    "site:up": "npm start",
    "postgres:up": "docker-compose up -d",
    "postgres:down": "docker-compose down",
    "postgres:reset": "docker-compose down -v",
    "check": "node scripts/check-dead-code.mjs && node scripts/check-references.mjs && node scripts/check-structure.mjs",
    "check:references": "node scripts/check-references.mjs",
    "db:migrate": "node scripts/db-migrate.mjs",
    "check:dead-code": "node scripts/check-dead-code.mjs",
    "check:structure": "node scripts/check-structure.mjs",
    "test": "node --test \"test/**/*.test.mjs\"",
    "smoke": "node scripts/smoke-api.mjs",
    "backup:db": "node scripts/backup-db.mjs",
    "backup:status": "node scripts/backup-status.mjs"
  },
  "dependencies": {
    "pg": "^8.13.1"
  }
}
