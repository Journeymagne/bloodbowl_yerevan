        "gata-league-auth-token": "mock"
      },
      "fullPage": false,
      "run": [
        "(async () => {",
        "  const wait = (ms) => new Promise((resolve) => setTimeout(resolve, ms));",
        "  const shown = (el) => el && el.getClientRects().length > 0;",
        "  const vis = (sel) => [...document.querySelectorAll(sel)].find(shown);",
        "  const press = async (sel, ms) => { const el = vis(sel); if (!el) throw new Error('no ' + sel); el.click(); await wait(ms || 500); };",
        "  const type = async (sel, value) => { const el = vis(sel); if (!el) throw new Error('no ' + sel); el.focus(); el.value = value; el.dispatchEvent(new Event('input', { bubbles: true })); await wait(200); };",
        "  await wait(400);",
        "  const LOGIN = 'newbie_coach';",
        "  await press('[data-coach-new]', 700);",
        "  await type('#coach-new-login', LOGIN);",
        "  await type('#coach-new-telegram', '@newbie');",
        "  await type('#coach-new-team', 'Mudfoot Boyz');",
        "  await press('[data-coach-race=\"teams/orc\"]', 400);",
        "  await wait(400);",
        "})()"
