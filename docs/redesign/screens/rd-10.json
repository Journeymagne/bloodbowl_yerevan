        "  const wait = (ms) => new Promise((resolve) => setTimeout(resolve, ms));",
        "  const shown = (el) => el && el.getClientRects().length > 0;",
        "  const byText = (re, sel) => [...document.querySelectorAll(sel || 'button, a, [role=\"tab\"], [role=\"radio\"]')].filter((el) => shown(el) && re.test(el.textContent.trim()));",
        "  const press = async (re, sel, nth, ms) => { const all = byText(re, sel); const i = nth || 0; if (all.length <= i) throw new Error('no ' + re); all[i].click(); await wait(ms || 500); };",
        "  await wait(400);",
        "  await press(/^Wrestle$/, 'button[data-skill]', 0, 800);",
