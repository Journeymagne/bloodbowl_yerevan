    {
      "id": "P2",
      "url": "http://localhost:5181/#/games/g2/post-match/players",
      "storage": {
        "gata-league-auth-token": "mock"
      },
      "fullPage": false,
      "run": [
        "(async () => {",
        "  const wait = (ms) => new Promise((resolve) => setTimeout(resolve, ms));",
        "  const shown = (el) => el && el.getClientRects().length > 0;",
        "  const vis = (sel) => [...document.querySelectorAll(sel)].find(shown);",
        "  const press = async (sel, ms) => { const el = vis(sel); if (!el) throw new Error('no ' + sel); el.click(); await wait(ms || 500); };",
        "  const sheet = () => { const open = document.querySelector('dialog[open]'); if (!open) throw new Error('no sheet open'); return open; };",
        "  const inSheet = (sel) => [...sheet().querySelectorAll(sel)].find(shown);",
        "  const pick = async (sel, ms) => { const el = inSheet(sel); if (!el) throw new Error('no ' + sel); el.click(); await wait(ms || 300); };",
        "  const firstOpen = (sel) => { const el = [...sheet().querySelectorAll(sel)].find((item) => shown(item) && item.getAttribute('aria-disabled') !== 'true'); if (!el) throw new Error('no open ' + sel); return el; };",
        "  const nextIfAny = async () => { const n = inSheet('[data-advance-next]'); if (n) { n.click(); await wait(300); } };",
        "  await wait(400);",
        "  await press('[data-after-player]', 700);",
        "  await wait(400);",
        "})()"
      ]
    },
